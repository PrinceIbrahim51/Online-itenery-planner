{
  "name": "voyagr-itinerary-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Premium, security-hardened online itinerary planner: sightseeing, food, stays, transport and cab/auto fare comparison.",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "NODE_ENV=development node --disable-warning=ExperimentalWarning --watch server/index.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "test": "NODE_ENV=test node --disable-warning=ExperimentalWarning --test 'test/**/*.test.js'",
    "audit:deps": "npm audit --omit=dev --audit-level=low",
    "scan:secrets": "node scripts/scan-secrets.js",
    "security:check": "npm run audit:deps && npm run scan:secrets && npm test"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
