# Copy to .env and fill in. NEVER commit the real .env file.

# development | production | test
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Production / Vercel: PostgreSQL connection string (e.g. Neon via Vercel → Storage).
# When set, it is used instead of SQLite. On Vercel, accounts stay disabled until it is set.
DATABASE_URL=

# Local development: SQLite database file (kept outside public/; the directory is git-ignored)
DATABASE_PATH=./data/voyagr.db

# Comma-separated list of origins allowed to call the API cross-origin.
# Leave empty to allow same-origin only (recommended).
CORS_ORIGINS=

# Number of reverse-proxy hops in front of the app (e.g. 1 behind Nginx/Render/Heroku).
# Needed so rate limiting sees the real client IP. 0 = no proxy. Defaults to 1 on Vercel.
TRUST_PROXY=

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Set to false ONLY for local http development. Must be true in production (HTTPS).
COOKIE_SECURE=true

# Optional: OpenTripMap key to plan places OUTSIDE India (all Indian cities work without any key).
# Used server-side only — it is never sent to the browser.
OPENTRIPMAP_API_KEY=

# Optional: Google Places API (New) key — accurate restaurant hours, temporary-closure
# status, price level, ratings and Google table reservations. Billed by Google per request
# (results are cached 12 h). Restrict the key to the Places API in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# Optional: Google Cloud Vision key — recognise landmarks in photos that have no GPS data.
# Restrict the key to the Vision API. Photos are forwarded once and never stored.
GOOGLE_VISION_API_KEY=

# Used only by `npm run create-admin` — remove from the env after creating the admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
